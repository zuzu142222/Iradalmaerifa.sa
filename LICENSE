        const particlesContainer=document.getElementById('particles');
        for(let i=0;i<50;i++){const p=document.createElement('div');p.className='particle';p.style.left=Math.random()*100+'%';p.style.animationDelay=Math.random()*15+'s';p.style.animationDuration=(10+Math.random()*10)+'s';particlesContainer.appendChild(p)}
        const observer=new IntersectionObserver((entries)=>{entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible')})},{threshold:0.1});
        document.querySelectorAll('.fade-in').forEach(el=>observer.observe(el));
